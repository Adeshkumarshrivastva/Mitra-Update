USE_DHWANI=False

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=
ELEVENLABS_TTS_VOICE_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Providers: STT_PROVIDER=elevenlabs|gemini|browser, TTS_PROVIDER=elevenlabs|edge, LLM_PROVIDER=gemini.
# Free with a Gemini key: STT_PROVIDER=gemini, TTS_PROVIDER=edge.
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs
LLM_PROVIDER=gemini
EDGE_TTS_VOICE=hi-IN-SwaraNeural

APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated STUN/TURN URIs, used by both the aiortc server and (mirrored
# manually) the React Native client. Needed off-LAN, e.g. a phone on cellular.
ICE_SERVERS=stun:stun.l.google.com:19302
MITRA_LOGIN_PIN=1234

# Optional legacy Dhwani mode. Keep USE_DHWANI=False for the WebRTC pipeline.
MITRA_AGENT_WS_URL=
MITRA_AGENT_NAME=mitra
MITRA_USER_NAME=Adesh
MITRA_GREETING=false
MITRA_READY_TIMEOUT=15
MITRA_REPLY_TIMEOUT=45
MITRA_CHECK_TEXT=Hello
MITRA_HOST=127.0.0.1
MITRA_PORT=5173
